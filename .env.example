# Salin ke .env.local dan isi nilai aktual

# PostgreSQL
DATABASE_URL=postgresql://user:***@host:5432/dbname
# DATABASE_SSL=true

# LLM (OpenAI-compatible) — fitur analisis potensi desa
# Endpoint harus mendukung format /v1/chat/completions (Bearer auth).
# Tanpa LLM_API_KEY -> narasi pakai template fallback (lihat src/lib/llm.ts:generateNarasi).
LLM_API_KEY=
LLM_BASE_URL=https://api.routr.cloud/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_MS=60000

# Password akses situs (opsional — middleware sederhana)
SITE_PASSWORD=
