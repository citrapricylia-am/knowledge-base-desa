# Salin ke .env.local dan isi nilai aktual

# PostgreSQL
DATABASE_URL=postgresql://user:***@host:5432/dbname
# DATABASE_SSL=true

# LLM (OpenAI-compatible) — fitur analisis potensi desa
# Endpoint harus mendukung format /v1/chat/completions (Bearer auth).
# Tanpa LLM_API_KEY -> narasi pakai template fallback (lihat src/lib/llm.ts:generateNarasi).
LLM_API_KEY=
LLM_BASE_URL=https://api.inferhub.dev/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_MS=60000
LLM_REASONING_EFFORT=low

# Aset hero (opsional) — host di CDN/Supabase Storage, bukan di repo.
# Kalau kosong, hero pakai poster statis saja (tidak error).
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=

# Password akses situs (opsional — middleware sederhana)
SITE_PASSWORD=
